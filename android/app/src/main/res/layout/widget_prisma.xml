<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRISMA"
        android:textColor="#20E0D1"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_month_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Este mês"
        android:textColor="#91A5BF"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/w_month_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$ 0,00"
        android:textColor="#FFFFFF"
        android:textSize="23sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_list_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 itens"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_vehicle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Veículo em dia"
            android:textColor="#91A5BF"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Toque para atualizar"
        android:textColor="#6F849E"
        android:textSize="8sp" />
</LinearLayout>
